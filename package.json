{
    "name": "Dopamine",
    "desktopName": "Dopamine",
    "version": "3.0.12",
    "versionSuffix": "",
    "copyright": "Copyright Digimezzo Ⓒ 2014 - 2026",
    "description": "Dopamine is an elegant audio player which tries to make organizing and listening to music as simple and pretty as possible.",
    "license": "GPL-3.0",
    "author": {
        "name": "Digimezzo",
        "email": "digimezzo@outlook.com",
        "url": "https://github.com/digimezzo/dopamine"
    },
    "homepage": "https://github.com/digimezzo/dopamine",
    "repository": {
        "type": "git",
        "url": "https://github.com/digimezzo/dopamine.git"
    },
    "bugs": {
        "url": "https://github.com/digimezzo/dopamine/issues"
    },
    "keywords": [
        "angular",
        "electron",
        "typescript",
        "sass"
    ],
    "main": "main.js",
    "private": true,
    "scripts": {
        "postinstall": "electron-builder install-app-deps && node patch-discord-rpc.js && node patch-taglib-sharp.js",
        "ng": "ng",
        "start": "npm-run-all -p ng:serve electron:serve",
        "build": "npm run electron:serve-tsc && ng build",
        "build:dev": "npm run build -- -c dev",
        "build:prod": "npm run build -- -c production",
        "ng:serve": "ng serve",
        "electron:serve-tsc": "tsc -p tsconfig-serve.json",
        "electron:serve": "wait-on http-get://localhost:4200/ && npm run electron:serve-tsc && electron . --serve --remote-debugging-port=9222",
        "electron:local": "npm run build:prod && electron .",
        "electron:linux": "npm run build:prod && electron-builder build --linux --config electron-builder.config.js && bash scripts/repackage-appimage-fuse3.sh release x86_64",
        "electron:windows": "npm run build:prod && electron-builder build --windows --config electron-builder.config.js",
        "electron:mac": "npm run build:prod && electron-builder build --mac --config electron-builder.config.js",
        "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
        "rebuild-sqlite": "./node_modules/.bin/electron-rebuild -f -o better-sqlite3",
        "test": "npx jest -w 1 --verbose --noStackTrace",
        "test-block": "npx jest -w 1 --verbose -t",
        "test-file": "npx jest -w 1 --verbose -i",
        "test-database-integration": "node electron-jest.js -w 1 --verbose --noStackTrace --config jest.database.integration.config.js",
        "lint": "ng lint"
    },
    "devDependencies": {
        "@angular-builders/custom-webpack": "^21.0.0",
        "@angular-devkit/build-angular": "^21.2.0",
        "@angular-eslint/builder": "^21.0.0",
        "@angular-eslint/eslint-plugin": "^21.0.0",
        "@angular-eslint/eslint-plugin-template": "^21.0.0",
        "@angular-eslint/schematics": "^21.0.0",
        "@angular-eslint/template-parser": "^21.0.0",
        "@angular/cli": "^21.2.0",
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/compiler-cli": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/language-service": "^21.2.0",
        "@angular/platform-browser": "^21.2.0",
        "@angular/platform-browser-dynamic": "^21.2.0",
        "@angular/router": "^21.2.0",
        "@ngx-translate/core": "15.0.0",
        "@ngx-translate/http-loader": "8.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.19.0",
        "@typescript-eslint/eslint-plugin": "5.48.2",
        "@typescript-eslint/parser": "5.48.2",
        "core-js": "2.6.1",
        "electron": "^38.0.0",
        "electron-builder": "26.15.7",
        "electron-reload": "1.5.0",
        "eslint": "^8.33.0",
        "jest": "^30.0.0",
        "jest-preset-angular": "16.2.0",
        "npm-run-all": "4.1.5",
        "prettier": "^3.0.3",
        "rxjs": "^7.8.2",
        "ts-jest": "29.4.15",
        "ts-node": "10.9.1",
        "tslint": "6.1.3",
        "typemoq": "2.1.0",
        "typescript": "5.9.3",
        "wait-on": "7.2.0",
        "zone.js": "~0.15.1",
        "jest-environment-jsdom": "^30.0.0",
        "jsdom": "^26.0.0"
    },
    "dependencies": {
        "@angular/animations": "^21.2.0",
        "@angular/cdk": "^21.2.0",
        "@angular/material": "^21.2.0",
        "@digimezzo/node-taglib-sharp": "^1.0.3",
        "@electron/remote": "2.1.3",
        "@fortawesome/fontawesome-free": "^6.6.0",
        "@jimp/core": "1.6.0",
        "@jsquash/webp": "^1.5.0",
        "angular-split": "14.1.0",
        "better-sqlite3": "12.5.0",
        "cheerio": "1.0.0-rc.12",
        "discord-rpc": "4.0.1",
        "electron-log": "4.4.8",
        "fast-sort": "^3.4.1",
        "fast-xml-parser": "4.3.2",
        "fs-extra": "11.1.1",
        "jimp": "1.6.0",
        "line-awesome": "1.3.0",
        "md5-typescript": "1.0.5",
        "moment": "2.29.4",
        "node-fetch": "2.6.11",
        "node-html-parser": "6.1.11",
        "node-vibrant": "^3.2.1-alpha.1",
        "sanitize-filename": "1.6.3",
        "tinycolor2": "1.6.0",
        "tslib": "2.0.0",
        "uuid": "9.0.0"
    }
}
